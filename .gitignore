# Environments / IDE
.venv/
venv/
.vscode/
.claude/

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# Working experiment outputs (curated snapshots live in experiments/).
# The pattern below was missing, so results/ was tracked while every doc
# described it as ignored.


# Raw SLURM logs — the ones worth keeping are promoted into experiments/
cluster/outputs/
slurm-*.out

# Corpus data: `python build_corpus.py` rebuilds it byte for byte; the
# committed MANIFEST carries the sha256 of every file.
corpus/*/*.jsonl
# The Zenodo release (GPL-3.0-or-later), downloaded by build_corpus.py.
corpus/zenodo/
