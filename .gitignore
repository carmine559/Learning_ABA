# Environments / IDE
.venv/
venv/
.vscode/
.claude/

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# results/ is tracked: runs on giano come back with git push.

# Raw SLURM logs; the ones worth keeping go into experiments/
cluster/outputs/

# Corpus: corpus/v1 and corpus/v1-permuted are tracked, so giano gets them with
# git pull; scratch builds (build_corpus.py --out corpus/<other>) stay local. The
# Zenodo release is GPL, downloaded by build_corpus.py.
corpus/*/*.jsonl
!corpus/v1/*.jsonl
!corpus/v1-permuted/*.jsonl
corpus/zenodo/

# LoRA weights (over GitHub's 100 MB limit) and checkpoints stay on scratch;
# runs/<run>/TRAINING_MANIFEST.json is tracked, and results/sft/<run>/
# EVAL_MANIFEST.json records the adapter's sha256.
runs/*/adapter/
runs/*/checkpoint-*/
